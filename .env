# Local dev only. Host ONLY, no /api/v1 suffix (src/utils/api.ts adds it).
# Metro inlines this at build time; the Docker image gets its value from the
# EXPO_PUBLIC_API_BASE_URL build ARG instead (.env is excluded by
# .dockerignore), so pointing this at localhost does not affect deployments.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
